; Mini Shop Tycoon — Transformation Phase I
config_version=5

[application]
config/name="Mini Shop Tycoon"
config/version="0.11.0"
run/main_scene="res://scenes/playable_shop.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]
Game="*res://scripts/game_manager.gd"

[display]
window/size/viewport_width=480
window/size/viewport_height=900
window/size/window_width_override=480
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.969, 0.953, 0.91, 1)
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true

[input_devices]
pointing/emulate_mouse_from_touch=false

